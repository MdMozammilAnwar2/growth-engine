# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Where the web app runs (for CORS). Comma-separate several.
CORS_ORIGINS=http://localhost:5173
# Public address of THIS server. Preview links sent to friends use it,
# so in production set it to your real domain (e.g. https://api.yourdomain.com).
PUBLIC_BASE_URL=http://localhost:4000

# ── Database (PostgreSQL) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=growth_engine
DB_USER=postgres
DB_PASSWORD=admin

# ── Login for the dashboard (single user) ──────────────
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string

# ── AI (optional but recommended) ──────────────────────
# Without a key, PDFs are parsed with a built-in rule-based parser and
# messages use plain templates. Screenshots need a key (vision model).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── GitHub Pages publishing ────────────────────────────
# Personal access token with "repo" scope (classic) or a fine-grained token
# with Administration + Contents + Pages read/write on the owner.
GITHUB_TOKEN=
# The account or organisation that will own one repo per person.
GITHUB_OWNER=anwar-portfolios
# "user" or "org"
GITHUB_OWNER_TYPE=org

# ── Branding on every generated site ───────────────────
CREDIT_NAME=Anwar
CREDIT_URL=https://wa.me/91XXXXXXXXXX
CREDIT_LINE=Need a website, web app or mobile app?

# ── Privacy ────────────────────────────────────────────
# Days after a "No thanks" before profile data and photos are deleted.
DECLINE_RETENTION_DAYS=30
